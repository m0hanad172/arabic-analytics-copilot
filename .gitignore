# ---- Python ----
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# ---- Node ----
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Env files (do NOT commit) ----
**/.env
**/.env.*
!**/.env.example

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Local model cache (HuggingFace / faster-whisper) ----
model_cache/

# ---- Tool backups / archives (not needed in git) ----
tools/archive/backups/
tools/*.bak.*

# ---- IMPORTANT ----
# We DO commit the DB dump:
# db/db_dump.sql is tracked in git on purpose.