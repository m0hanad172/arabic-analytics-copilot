# Backend runtime
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Active database backend. Postgres is the working default.
# SQL Server dialect is being introduced in phases; full /ask SQL Server
# parity is still pending (depends on porting bi_meta.* PG functions).
DATABASE_BACKEND=postgres
# DATABASE_BACKEND=sqlserver

# Postgres (local Docker container, e.g. `aac-pg`)
# These DB_* vars are reference values; the runtime reads DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arabic_analytics
DB_USER=copilot_ro
DB_PASSWORD=aac123

# SQLAlchemy async URL (recommended). Used when DATABASE_BACKEND=postgres.
DATABASE_URL=postgresql+asyncpg://copilot_ro:aac123@localhost:5432/arabic_analytics

# For SQL Server, set DATABASE_BACKEND=sqlserver above and use a URL such as:
# DATABASE_URL=mssql+aioodbc://user:pass@host:1433/arabic_analytics?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no
# Note: /ask still requires Phase C (bi_meta.* port). Health/schema/query
# routes work; /ask returns HTTP 501 with a controlled message until then.

# Allowlist (semantic layer)
SQL_ALLOWED_SCHEMAS=bi,bi_meta
ALLOWED_SCHEMA=bi

# Safety
DEFAULT_MAX_ROWS=200
STATEMENT_TIMEOUT_MS=8000
DEDUPE_SYNONYMS=1

# Gemini (Optional)
# Leave empty in .env.example (do NOT commit secrets)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
GEMINI_MODEL=models/gemini-2.5-flash

# If you don't have a valid key, keep LLM disabled.
LLM_ENABLED=0
LLM_TIMEOUT_SECONDS=25
LLM_CONCURRENCY=1
LLM_MAX_KEYS_IN_PROMPT=35
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=1
LLM_BACKOFF_SECONDS_QUOTA=20
LLM_BACKOFF_SECONDS_TIMEOUT=3