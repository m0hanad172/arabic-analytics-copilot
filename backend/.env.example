# Backend runtime
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Active database backend. Postgres is the working default.
# SQL Server dialect is being introduced in phases; full /ask SQL Server
# parity is still pending (depends on porting bi_meta.* PG functions).
DATABASE_BACKEND=postgres
# DATABASE_BACKEND=sqlserver

# Plan-to-SQL compiler backend (Phase C1).
#   db     = use bi_meta.compile_query inside PostgreSQL (current behaviour).
#   python = use the in-process semantic compiler.
# Default is "db". The "python" path is wired into /ask in Phase C2.
COMPILER_BACKEND=db
# COMPILER_BACKEND=python

# Postgres (local Docker container, e.g. `aac-pg`)
# These DB_* vars are reference values; the runtime reads DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arabic_analytics
DB_USER=copilot_ro
DB_PASSWORD=<postgres_password>

# SQLAlchemy async URL (recommended). Used when DATABASE_BACKEND=postgres.
DATABASE_URL=postgresql+asyncpg://copilot_ro:<postgres_password>@localhost:5432/arabic_analytics

# For SQL Server, set DATABASE_BACKEND=sqlserver and COMPILER_BACKEND=python.
# Use the odbc_connect= form for named instances: a backslash in the
# host (".\SQLEXPRESS") cannot survive a netloc URL even URL-encoded
# (aioodbc receives a literal "%5C"). Do not use the
# mssql+...://@.%5CSQLEXPRESS/... netloc style.
#
# Helper scripts read these MSSQL_* values. SQL auth is used only when
# both MSSQL_USER and MSSQL_PASSWORD are set; otherwise Windows
# Trusted_Connection is used. Keep MSSQL_PASSWORD local only.
MSSQL_SERVER=.\SQLEXPRESS
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_DATABASE=ArabicAnalytics
# MSSQL_USER=<sql_login>
# MSSQL_PASSWORD=<sql_password>
#
# SQL Server DATABASE_URL examples must use SQLAlchemy odbc_connect=:
#
# Windows Authentication / Trusted_Connection:
#
# DATABASE_URL=mssql+aioodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DArabicAnalytics%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3BEncrypt%3Dno%3B
#
# SQL Authentication (requires Mixed Mode enabled in SQL Server):
# DATABASE_URL=mssql+aioodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DArabicAnalytics%3BUID%3D%3Csql_login%3E%3BPWD%3D%3Csql_password%3E%3BTrustServerCertificate%3Dyes%3BEncrypt%3Dno%3B
#
# Sync pyodbc variant (no aioodbc dependency, but blocks the event loop):
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER%3D%7BODBC+Driver+18+for+SQL+Server%7D%3BSERVER%3D.%5CSQLEXPRESS%3BDATABASE%3DArabicAnalytics%3BTrusted_Connection%3Dyes%3BTrustServerCertificate%3Dyes%3BEncrypt%3Dno%3B
#
# See docs/SQLSERVER_MIGRATION_PLAN.md and backend/db/sqlserver/README.md
# for the schema setup that has to run before /ask works on SQL Server.

# Allowlist (semantic layer)
SQL_ALLOWED_SCHEMAS=bi,bi_meta
ALLOWED_SCHEMA=bi

# Safety
DEFAULT_MAX_ROWS=200
STATEMENT_TIMEOUT_MS=8000
DEDUPE_SYNONYMS=1

# Plan-cache namespace. Bump this after planner/compiler behavior changes
# so old bi_meta.plan_cache rows are not reused. Query_log history is not
# affected. To clear SQL Server plan cache manually:
# DELETE FROM bi_meta.plan_cache;
PLAN_CACHE_VERSION=planner-v6

# Gemini (Optional)
# Leave empty in .env.example (do NOT commit secrets)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
GEMINI_MODEL=models/gemini-2.5-flash

# If you don't have a valid key, keep LLM disabled.
LLM_ENABLED=0
LLM_TIMEOUT_SECONDS=25
LLM_CONCURRENCY=1
LLM_MAX_KEYS_IN_PROMPT=35
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=1
LLM_BACKOFF_SECONDS_QUOTA=20
LLM_BACKOFF_SECONDS_TIMEOUT=3
