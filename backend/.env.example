# Backend runtime
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arabic_analytics
DB_USER=copilot_ro
DB_PASSWORD=aac123

# SQLAlchemy async URL (recommended)
DATABASE_URL=postgresql+asyncpg://copilot_ro:aac123@localhost:5432/arabic_analytics

# Allowlist (semantic layer)
SQL_ALLOWED_SCHEMAS=bi,bi_meta
ALLOWED_SCHEMA=bi

# Safety
DEFAULT_MAX_ROWS=200
STATEMENT_TIMEOUT_MS=8000
DEDUPE_SYNONYMS=1

# Gemini (Optional)
# Leave empty in .env.example (do NOT commit secrets)
GEMINI_API_KEY=
GEMINI_API_VERSION=v1beta
GEMINI_MODEL=models/gemini-2.5-flash

# If you don't have a valid key, keep LLM disabled.
LLM_ENABLED=0
LLM_TIMEOUT_SECONDS=25
LLM_CONCURRENCY=1
LLM_MAX_KEYS_IN_PROMPT=35
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=1
LLM_BACKOFF_SECONDS_QUOTA=20
LLM_BACKOFF_SECONDS_TIMEOUT=3